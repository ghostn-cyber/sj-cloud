# ==========================================
# SJ Cloud Production Configuration Overrides
# ==========================================
PLATFORM_ENV=production
PLATFORM_BASE_DOMAIN=sj-cloud.com
PLATFORM_PUBLIC_URL=https://sj-cloud.com
PLATFORM_ADMIN_URL=https://admin.sj-cloud.com
PLATFORM_API_URL=https://api.sj-cloud.com
PLATFORM_METRICS_URL=https://metrics.sj-cloud.com
PLATFORM_REGISTRY_URL=https://registry.sj-cloud.com
PLATFORM_MESH_URL=https://mesh.sj-cloud.com

# Enforce secure HTTPS routes
FORCE_HTTPS=true
TLS_ENABLED=true
TLS_MIN_VERSION=VersionTLS13

# Production allocation sizes
DEFAULT_CPU_LIMIT=1.0
DEFAULT_MEMORY_LIMIT=512M
DEFAULT_STORAGE_LIMIT=20Gi
DEFAULT_REPLICAS=2
MAX_REPLICAS=10
AUTOSCALING_ENABLED=true
