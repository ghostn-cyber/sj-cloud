# ==========================================
# SJ Cloud Development Configuration Overrides
# ==========================================
PLATFORM_ENV=development
PLATFORM_BASE_DOMAIN=sj-cloud.test
PLATFORM_PUBLIC_URL=http://sj-cloud.test
PLATFORM_ADMIN_URL=http://admin.sj-cloud.test
PLATFORM_API_URL=http://api.sj-cloud.test

# Disable force HTTPS to ease local manual requests
FORCE_HTTPS=false
TLS_ENABLED=true

# Keep local resources lightweight
DEFAULT_CPU_LIMIT=0.1
DEFAULT_MEMORY_LIMIT=64M
