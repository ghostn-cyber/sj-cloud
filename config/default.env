# ==========================================
# SJ Cloud Default Configuration File
# ==========================================

# --- Platform metadata ---
# The human-readable name of this platform instance
PLATFORM_NAME=SJ Cloud
# Current platform version
PLATFORM_VERSION=1.0.0
# The target execution environment (development, testing, staging, production)
PLATFORM_ENV=development
# Multi-region deployment identifier
PLATFORM_REGION=us-east-1
# System timezone
PLATFORM_TIMEZONE=UTC
# Base domain name for ingress routing
PLATFORM_BASE_DOMAIN=sj-cloud.test
# Public-facing dashboard URL
PLATFORM_PUBLIC_URL=http://sj-cloud.test
# Administration console endpoint
PLATFORM_ADMIN_URL=http://admin.sj-cloud.test
# Central API entry point
PLATFORM_API_URL=http://api.sj-cloud.test
# Observability metrics query endpoint
PLATFORM_METRICS_URL=http://metrics.sj-cloud.test
# Internal service registry endpoint
PLATFORM_REGISTRY_URL=http://registry.sj-cloud.test
# Service mesh telemetry and routing endpoint
PLATFORM_MESH_URL=http://mesh.sj-cloud.test

# --- Networking ---
# Standard HTTP port exposed to public traffic
HTTP_PORT=80
# Standard HTTPS port exposed to public traffic
HTTPS_PORT=443
# Admin/Dashboard port for Traefik ingress gateway
TRAEFIK_PORT=8080
# Docker network name for front-facing routing
PROXY_NETWORK=sj-proxy
# Docker network name for internal service-to-service communication
SERVICE_NETWORK=sj-services
# Docker network name for isolated database connections
DATA_NETWORK=sj-data
# Docker network name for telemetry metrics collection
MONITORING_NETWORK=sj-monitoring
# Docker network name for scheduled database archiving
BACKUP_NETWORK=sj-backup

# --- Routing ---
# Default subdomain schema for new tenant control planes
DEFAULT_TENANT_DOMAIN=*.sj-cloud.test
# Default subdomain schema for hosting application workloads
DEFAULT_APPLICATION_DOMAIN=*.apps.sj-cloud.test
# Toggle support for legacy non-standard URLs
ENABLE_LEGACY_DOMAINS=false
# Enforce global redirection from HTTP to HTTPS
FORCE_HTTPS=true
# Enable TLS layer for all secure communication
TLS_ENABLED=true
# Minimum supported TLS protocol version
TLS_MIN_VERSION=VersionTLS12
# Path on filesystem containing active SSL certificates
CERTIFICATE_DIRECTORY=/etc/traefik/certs

# --- Resource limits ---
# Default CPU limit allocation for standard tenant workloads
DEFAULT_CPU_LIMIT=0.2
# Default RAM allocation for standard tenant workloads
DEFAULT_MEMORY_LIMIT=128M
# Default persistent disk storage limit for tenant applications
DEFAULT_STORAGE_LIMIT=5Gi
# Default number of runtime replica containers
DEFAULT_REPLICAS=1
# Maximum replication capacity for autoscaled workloads
MAX_REPLICAS=5
# Default HTTP connection timeout in milliseconds
DEFAULT_TIMEOUT=5000
# Maximum request lifecycle duration in milliseconds
REQUEST_TIMEOUT=10000
# Maximum compilation phase execution duration in milliseconds
BUILD_TIMEOUT=300000
# Maximum orchestration lifecycle duration in milliseconds
DEPLOYMENT_TIMEOUT=60000
# Maximum CI execution pipeline duration in milliseconds
PIPELINE_TIMEOUT=600000

# --- Database ---
# Hostname resolving to Postgres service
POSTGRES_HOST=postgres
# Listening port of Postgres service
POSTGRES_PORT=5432
# Default system control plane database name
POSTGRES_DATABASE=sj_tenant_manager
# Max connection pool size to Postgres server
POSTGRES_POOL_SIZE=10
# Hostname resolving to Redis service
REDIS_HOST=redis
# Listening port of Redis service
REDIS_PORT=6379
# Endpoint URL resolving to MinIO storage cluster
MINIO_ENDPOINT=http://minio:9000
# Named bucket for storing daily database archives
MINIO_BUCKET_BACKUPS=backups
# Named bucket for storing pipeline release tarballs
MINIO_BUCKET_RELEASES=releases
# Named bucket for storing build assets
MINIO_BUCKET_ARTIFACTS=artifacts
# Named bucket for storing system auditing logs
MINIO_BUCKET_LOGS=logs

# --- Monitoring ---
# Core Prometheus server query endpoint
PROMETHEUS_ENDPOINT=http://prometheus:9090
# Core Grafana visualization endpoint
GRAFANA_ENDPOINT=http://grafana:3000
# Loki log ingestion endpoint
LOKI_ENDPOINT=http://loki:3100
# OpenTelemetry ingestion receiver endpoint
OTEL_ENDPOINT=http://otel-collector:4317
# Jaeger tracing console endpoint
JAEGER_ENDPOINT=http://jaeger:16686
# Alertmanager notification dispatch endpoint
ALERTMANAGER_ENDPOINT=http://alertmanager:9093
# Retention duration for system metrics in days
METRIC_RETENTION_DAYS=15
# Retention duration for structured log outputs in days
LOG_RETENTION_DAYS=30
# Retention duration for Jaeger traces in days
TRACE_RETENTION_DAYS=7

# --- Security ---
# Expiration window for authentication JSON Web Tokens
JWT_EXPIRATION=3600
# Inactivity threshold before session termination
SESSION_TIMEOUT=1800
# Complexity rules for tenant administrator passwords
PASSWORD_POLICY=strong
# Toggle file-based auditing of admin actions
ENABLE_AUDIT_LOGGING=true
# Toggle capture of request-level trace boundaries
ENABLE_TRACING=true
# Toggle active metric publishing via metrics endpoints
ENABLE_METRICS=true
# Toggle active connection throttling and rate limiting
ENABLE_RATE_LIMITING=true
# Toggle strict TLS verification for internal services
ENABLE_TLS=true
# Toggle injecting standard security headers (HSTS, CSP) in proxy
ENABLE_SECURITY_HEADERS=true

# --- Scaling ---
# Toggle automated replica adjustments based on load
AUTOSCALING_ENABLED=false
# Minimum replica capacity allowed under autoscaling
DEFAULT_MIN_REPLICAS=1
# Maximum replica capacity allowed under autoscaling
DEFAULT_MAX_REPLICAS=5
# CPU usage trigger percentage for scaling out replicas
CPU_SCALE_THRESHOLD=80
# Memory usage trigger percentage for scaling out replicas
MEMORY_SCALE_THRESHOLD=85

# --- Backups ---
# Preservation period for scheduled database dumps in days
BACKUP_RETENTION_DAYS=7
# Backup trigger cron expression / duration in seconds
BACKUP_INTERVAL=86400
# Compression method used for backup archives
BACKUP_COMPRESSION=gzip
# Perform dry-run restore validation on newly created backups
VERIFY_BACKUPS=true

# --- Build Engine ---
# Default base container image builder
DEFAULT_BUILDER=docker
# Toggle local build caches to speed up compilations
BUILD_CACHE=true
# Registry hosting compiled application images
IMAGE_REGISTRY=sj-registry:5000
# Namespace grouping tenant images inside the registry
IMAGE_NAMESPACE=tenants
# Max number of historical images retained per application
IMAGE_RETENTION=5

# --- Pipeline Engine ---
# Max concurrent pipeline executions allowed globally
PIPELINE_CONCURRENCY=2
# Max parallel build jobs allowed per single pipeline execution
PIPELINE_PARALLELISM=4
# Expiration threshold for pipelines awaiting manual approval (seconds)
MANUAL_APPROVAL_TIMEOUT=3600
# Toggle automated vuln scanner during build phase
ENABLE_SECURITY_SCAN=true
# Toggle automated Software Bill of Materials (SBOM) indexing
ENABLE_SBOM=true

# --- Feature Flags ---
# Enable tenant CI/CD pipeline capabilities
ENABLE_PIPELINES=true
# Enable application deployment capabilities
ENABLE_APPLICATIONS=true
# Enable horizontal pod/container autoscaling
ENABLE_AUTOSCALING=false
# Enable cross-datacenter routing configurations
ENABLE_MULTI_REGION=false
# Enable proxy service mesh enforcement
ENABLE_MESH=true
# Enable centralized dashboard monitoring
ENABLE_MONITORING=true
# Enable centralized tracing
ENABLE_TRACING=true
# Enable daily backup jobs
ENABLE_BACKUPS=true
