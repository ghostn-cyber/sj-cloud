# ==========================================
# SJ Cloud Testing Configuration Overrides
# ==========================================
PLATFORM_ENV=testing
PLATFORM_BASE_DOMAIN=sj-cloud.test
PLATFORM_PUBLIC_URL=http://sj-cloud.test
PLATFORM_ADMIN_URL=http://admin.sj-cloud.test
PLATFORM_API_URL=http://api.sj-cloud.test

# Testing database isolation
POSTGRES_DATABASE=sj_tenant_manager_test

# Disable secure redirects in local testing
FORCE_HTTPS=false
TLS_ENABLED=false

# Aggressive timeouts to accelerate integration test suites
DEFAULT_TIMEOUT=1000
REQUEST_TIMEOUT=2000
BUILD_TIMEOUT=30000
DEPLOYMENT_TIMEOUT=10000
PIPELINE_TIMEOUT=60000
