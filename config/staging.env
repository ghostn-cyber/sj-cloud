# ==========================================
# SJ Cloud Staging Configuration Overrides
# ==========================================
PLATFORM_ENV=staging
PLATFORM_BASE_DOMAIN=staging.sj-cloud.com
PLATFORM_PUBLIC_URL=https://staging.sj-cloud.com
PLATFORM_ADMIN_URL=https://admin.staging.sj-cloud.com
PLATFORM_API_URL=https://api.staging.sj-cloud.com
PLATFORM_METRICS_URL=https://metrics.staging.sj-cloud.com
PLATFORM_REGISTRY_URL=https://registry.staging.sj-cloud.com
PLATFORM_MESH_URL=https://mesh.staging.sj-cloud.com

# Enforce HTTPS routing in staging environments
FORCE_HTTPS=true
TLS_ENABLED=true

# Moderate resources mapping
DEFAULT_CPU_LIMIT=0.5
DEFAULT_MEMORY_LIMIT=256M
DEFAULT_STORAGE_LIMIT=10Gi
